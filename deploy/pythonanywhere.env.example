# ═══════════════════════════════════════════════════════════
# Club Hold'em — production env (PythonAnywhere / Mini App)
# Copy to: apps/api/.env  and fill values from BotFather
# ═══════════════════════════════════════════════════════════

# --- From BotFather (обязательно) ---
# 1) @BotFather → /newbot → скопируй токен
TELEGRAM_BOT_TOKEN=

# 2) Твой числовой Telegram user id (не @username).
#    Узнать: напиши @userinfobot или @getmyid_bot → Id
#    Несколько админов через запятую: 123456789,987654321
ADMIN_TELEGRAM_IDS=

# --- Сгенерируй сам (обязательно) ---
# openssl rand -hex 32
JWT_SECRET=

# --- Хостинг (подставь свои URL после деплоя) ---
# Mini App HTTPS URL (статика web) — тот же URL укажешь в BotFather → Mini App
CORS_ORIGIN=https://kiosk-hedgehog22.eu.pythonanywhere.com

# API/WS URL (куда ходит фронт). Если API на том же домене через прокси —
# оставь тот же origin; иначе URL always-on / внешнего Node-хоста.
PORT=8000
DATABASE_URL="file:./prod.db"
DEV_BYPASS_AUTH=0
SIGNUP_BONUS_CHIPS=10000

# --- USDT TRC20 deposits (self-custody: only your receive address) ---
# Адрес получения USDT в сети TRON из Trust Wallet (начинается с T…)
TRON_USDT_ADDRESS=
# Контракт USDT TRC20 mainnet (можно не менять)
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# Ключ TronGrid (https://www.trongrid.io/) — для чтения входящих переводов
TRONGRID_API_KEY=
# Сколько фишек даём за 1 USDT
CHIPS_PER_USDT=100
# Сколько минут живёт заявка с уникальной суммой
DEPOSIT_TTL_MINUTES=60
# Включить авто-поиск оплат (1 = да). Нужны TRON_USDT_ADDRESS (+ лучше API key)
TRON_WATCH_ENABLED=1
# Интервал опроса TronGrid (мс)
TRON_WATCH_INTERVAL_MS=20000

# --- Web build (apps/web/.env.production) ---
# VITE_API_URL и VITE_WS_URL должны указывать на публичный HTTPS API
# Пример:
# VITE_API_URL=https://hedgehog22.eu.pythonanywhere.com
# VITE_WS_URL=https://hedgehog22.eu.pythonanywhere.com
