generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  telegramId  String   @unique
  name        String
  username    String?
  avatarUrl   String?
  role        String   @default("user") // user | admin
  whitelisted Boolean  @default(false)
  balance     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invitesCreated Invite[]       @relation("InviteCreator")
  seats          TableSeat[]
  ledger         LedgerEntry[]
  deposits       DepositIntent[]
  messages       ChatMessage[]
  tablesCreated  PokerTable[]   @relation("TableCreator")
}

model Invite {
  id          String    @id @default(cuid())
  code        String    @unique
  maxUses     Int       @default(1)
  uses        Int       @default(0)
  expiresAt   DateTime?
  createdById String
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
}

/** Singleton club rules (id always 1). Rake applies to every new/open table. */
model ClubSettings {
  id          Int      @id @default(1)
  rakePercent Int      @default(5)
  rakeCapBb   Int      @default(3)
  updatedAt   DateTime @updatedAt
}

model PokerTable {
  id          String   @id @default(cuid())
  name        String
  smallBlind  Int
  bigBlind    Int
  /** Pot rake % (cash standard). Default 5 */
  rakePercent Int      @default(5)
  /** Rake cap in big blinds. Default 3 (= GG-style 3BB) */
  rakeCapBb   Int      @default(3)
  maxSeats    Int      @default(6)
  status      String   @default("open") // open | closed
  /** Short shareable join code (TBL-XXXXXX), like club invite UX */
  inviteCode  String?  @unique
  createdById String
  createdBy   User     @relation("TableCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  seats    TableSeat[]
  hands    Hand[]
  messages ChatMessage[]
}

model TableSeat {
  id        String @id @default(cuid())
  tableId   String
  userId    String
  seatIndex Int
  stack     Int
  sittingOut Boolean @default(false)

  table PokerTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id])

  @@unique([tableId, seatIndex])
  @@unique([tableId, userId])
}

model Hand {
  id        String   @id @default(cuid())
  tableId   String
  handNo    Int
  board     String   // JSON
  pot       Int
  winners   String   // JSON
  history   String   // JSON
  createdAt DateTime @default(now())

  table PokerTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
}

model LedgerEntry {
  id        String   @id @default(cuid())
  userId    String
  kind      String // signup_bonus | deposit | withdraw | buy_in | cash_out | adjust
  amount    Int
  meta      String? // JSON
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model DepositIntent {
  id               String    @id @default(cuid())
  userId           String
  amountChips      Int
  /** Exact USDT amount to send, in micro-units (1 USDT = 1_000_000). Unique among open pending. */
  amountUsdtMicro  Int?
  asset            String    @default("USDT")
  network          String    @default("TRC20")
  status           String    @default("pending") // pending | confirmed | cancelled | expired
  externalRef      String?
  payAddress       String?
  txid             String?   @unique
  confirmedBy      String? // auto | admin
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([status, amountUsdtMicro])
  @@index([status, expiresAt])
}

/** Incoming TRC20 USDT that did not match any pending intent. */
model UnmatchedDeposit {
  id              String   @id @default(cuid())
  txid            String   @unique
  amountUsdtMicro Int
  fromAddress     String?
  toAddress       String?
  note            String?
  status          String   @default("open") // open | linked | ignored
  linkedIntentId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  tableId   String
  userId    String
  text      String
  createdAt DateTime @default(now())

  table PokerTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id])
}
